<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
        <PackageReference Include="FsCheck.Xunit.v3" Version="3.5.0" />
        <PackageReference Include="coverlet.MTP" Version="10.1.0">
            <PrivateAssets>all</PrivateAssets>
            <!-- 'compile' is required: MTP generates SelfRegisteredExtensions.cs that calls
                 Coverlet.MTP.TestingPlatformBuilderHook, which lives in coverlet.MTP.dll. -->
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive; compile</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\SwtBlackbox.Atm\SwtBlackbox.Atm.csproj" />
        <ProjectReference Include="..\SwtBlackbox.Tests\SwtBlackbox.Tests.csproj" />
    </ItemGroup>
</Project>
